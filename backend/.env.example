# Admin session authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Azure AI Foundry agent configuration
AZURE_EXISTING_AIPROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>
AZURE_EXISTING_AGENT_ID=<your-agent-name>:<version>

# Azure Speech TTS configuration
AZURE_LOCATION=eastus2
AZURE_SPEECH_ENDPOINT=https://<your-speech-resource>.cognitiveservices.azure.com/
AZURE_SPEECH_KEY=<your-speech-key>
AZURE_SPEECH_VOICE_NAME=th-TH-PremwadeeNeural
AZURE_SPEECH_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3

# Frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Optional azd or deployment metadata
# AZURE_ENV_NAME=
# AZURE_LOCATION=
# AZURE_SUBSCRIPTION_ID=
# AZURE_EXISTING_AIPROJECT_RESOURCE_ID=
# AZURE_EXISTING_RESOURCE_ID=
# AZD_ALLOW_NON_EMPTY_FOLDER=true
